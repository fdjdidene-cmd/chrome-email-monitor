{
  "manifest_version": 3,
  "name": "Email Monitor",
  "version": "1.0.0",
  "description": "Surveille en temps réel l'ouverture des emails et extrait les informations",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Email Monitor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}